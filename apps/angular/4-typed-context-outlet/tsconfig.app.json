{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "types": [],
    "target": "ES2022",
    "module": "es2022",
    "useDefineForClassFields": false,
    "moduleResolution": "bundler"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true // <-- ADD THIS LINE
  },
  "files": [
    "src/main.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.html"
  ],
  "exclude": [
    "jest.config.ts",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}